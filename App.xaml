<Application x:Class="TileBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Win10 磁贴板用的基础色板：带 alpha，让底下的亚克力透出来 -->
        <SolidColorBrush x:Key="BoardBack" Color="#A61B1B1B"/>
        <SolidColorBrush x:Key="RailBack" Color="#7A101010"/>
        <SolidColorBrush x:Key="HoverBack" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="TextMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextSub" Color="#9A9A9A"/>

        <!-- ================= Win10 开始菜单的滚动条 =================
             系统默认滚动条是资源管理器那套（带上下箭头、占 17px、浅色轨道）。
             Win10 开始菜单的是一条 4px 宽的细圆角条，没有箭头，平时几乎看不见。
        -->
        <Style x:Key="Win10ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="2" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#78FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Win10ScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Win10ScrollThumb}"/>
                                </Track.Thumb>
                                <!-- 关键：没有 PageUp/PageDown 两块 RepeatButton，就不会出现箭头 -->
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                                <Setter Property="Width" Value="4"/>
                                <Setter Property="MinWidth" Value="4"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <!-- 磁贴板的横向位置条：和竖向那根一样是 4px 细圆角条 -->
                                <Setter Property="Height" Value="4"/>
                                <Setter Property="MinHeight" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 隐式样式：ScrollViewer / ListBox 内部的滚动条全部换掉 -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Win10ScrollBar}"/>

        <!-- 左侧图标栏按钮 -->
        <!-- 圆形头像遮罩：ClipToBounds 只裁矩形边，径向渐变裁真圆，0.999→1 过渡带抹锯齿 -->
        <RadialGradientBrush x:Key="CircleClipMask" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#FF000000" Offset="0.999"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBack}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部文字按钮 -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#404040"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 外观浮层里的滑块 / 勾选框 =================
             系统默认那套是浅色轨道 + 白色方块，压在深色浮层上像贴上去的补丁。
             这里换成 Win10 的观感：3px 细轨，拖到的一侧亮，另一侧暗，圆点手柄。
        -->
        <ControlTemplate x:Key="SliderFillBar" TargetType="RepeatButton">
            <Border Height="3" CornerRadius="1.5" Background="#D8FFFFFF" VerticalAlignment="Center"/>
        </ControlTemplate>

        <ControlTemplate x:Key="SliderEmptyBar" TargetType="RepeatButton">
            <Border Height="3" CornerRadius="1.5" Background="#38FFFFFF" VerticalAlignment="Center"/>
        </ControlTemplate>

        <Style x:Key="SliderThumbDot" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="14" Height="14" Background="Transparent">
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#F2FFFFFF"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="13"/>
                                <Setter TargetName="Dot" Property="Height" Value="13"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="13"/>
                                <Setter TargetName="Dot" Property="Height" Value="13"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  Template="{StaticResource SliderFillBar}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbDot}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                  Template="{StaticResource SliderEmptyBar}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="2"
                                    BorderThickness="1" BorderBrush="#8AFFFFFF" Background="#1FFFFFFF"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" Foreground="#0A0A0A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F2FFFFFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#F2FFFFFF"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 右键菜单 =================
             菜单项多到超出屏幕时，WPF 会给菜单套一个 ScrollViewer。
             默认那套滚动条就是资源管理器样式（17px、带上下箭头），
             和深色菜单放在一起非常突兀。这里把菜单专用的 ScrollViewer 换掉：
             滚动条部分只留 4px 细轨，和磁贴板自己的滚动条一模一样。
             （这个 ComponentResourceKey 是 WPF 菜单模板里写死的键，覆盖它才会生效。） -->
        <Style x:Key="TileMenuScroll" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Width="4" Margin="1,2,2,2"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="Visible"
                                       Style="{StaticResource Win10ScrollBar}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 装不下才画这条 4px 细轨；装得下就彻底不出现（否则菜单右边会挂一条淡痕） -->
                            <Trigger Property="ScrollableHeight" Value="0">
                                <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 这个 ComponentResourceKey 是 WPF 菜单模板里写死的键，覆盖它才能连子菜单一起换掉 -->
        <Style x:Key="{ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}"
               TargetType="ScrollViewer"
               BasedOn="{StaticResource TileMenuScroll}"/>

        <!-- 右键菜单本体：Win10 磁贴菜单同款 —— #2B2B2B 不透明底、直角、1px 细描边 -->
        <Style x:Key="TileMenu" TargetType="ContextMenu">
            <!-- 底色不透明：菜单只有 130px 宽，一旦透出背后的磁贴文字，
                 「个性化设置」和「从磁贴板移除」就会和底下的字糊在一起 -->
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0" Padding="0">
                            <ScrollViewer Focusable="False" Style="{StaticResource TileMenuScroll}">
                                <StackPanel IsItemsHost="True" Margin="0,4"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 菜单项 =================
             上面那个 TileMenu 只管了 ContextMenu 这一层外壳。菜单项自己是 MenuItem，
             走的是 WPF 默认模板：浅灰底、深灰字、系统蓝高亮 —— 套在深色菜单里
             就是「一片糊，几乎读不出来」。所以模板必须整套换掉，不能只改颜色。

             结构照 Win10 磁贴右键菜单（主人给的截图）：
             左边 44px 图标列放 16px 线性图标，右边是子菜单箭头，行高 32，
             悬停高亮用强调蓝 —— 开始菜单的磁贴菜单悬停就是这一条蓝。
        -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标列：菜单项自带的 Icon（MDL2 线性图标），Win10 同位置 -->
                                <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                  Width="44" VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  TextElement.Foreground="#CCCCCC"/>

                                <!-- 勾选标记：走 IsChecked 的项显示在这里（图标列空着时才看得到） -->
                                <TextBlock x:Name="Glyph" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" Margin="0,0,20,0"/>

                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="#C8C8C8" Margin="0,0,12,0"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>

                                <!-- 子菜单：必须叫 PART_Popup，WPF 靠这个名字接管展开 -->
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       Placement="Right" HorizontalOffset="-1" VerticalOffset="-5">
                                    <Border Background="#FF2B2B2B" BorderBrush="#33FFFFFF"
                                            BorderThickness="1" CornerRadius="0">
                                        <ScrollViewer Focusable="False" Style="{StaticResource TileMenuScroll}">
                                            <ItemsPresenter x:Name="ItemsPresenter" Margin="0,4"
                                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- 悬停高亮：Win10 磁贴菜单同款强调蓝，白字 -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0078D7"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Tag=PlainHost 的行是「装内容的托盘」（色板 / RGB 滑块），
                                 不是可点的命令：悬停只给一层淡灰，别整块刷成强调蓝 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                    <Condition Property="Tag" Value="PlainHost"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#FF333333"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#7C7C7C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分隔线：左边缩进到图标列之后，颜色淡到只是「一层断」，不抢眼 -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1FFFFFFF" Margin="34,4,0,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单项已经统一成深色了，外壳也得跟上：
             搜索框、重命名框这些 WPF 内置的编辑菜单是运行时自己 new 出来的 ContextMenu，
             走的正是隐式样式。不兜这一层，就会出现「浅色外壳里装着深色菜单项」。 -->
        <Style TargetType="ContextMenu" BasedOn="{StaticResource TileMenu}"/>

    </Application.Resources>
</Application>
