<Window x:Class="TileBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TileBoard.Controls"
        Title="磁贴板"
        Width="560" Height="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid x:Name="RootGrid" Background="Transparent" Opacity="0" RenderTransformOrigin="0.5,0.5"
          PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown">
        <!-- 淡入用的位移：窗口一出现就在 10px 下方，然后再升上来。
             透明度和位移都挂在根容器而不是 Window 上 —— 分层窗口动 Window.Opacity
             会每帧重建整窗位图，表现就是「先闪一下再出现」。 -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="10"/>
        </Grid.RenderTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 背景层 ============
             整窗唯一的底色/背景图都铺在这一层：图片在下、染色在上。
             板面、设置页、手机页的底色全部让空（透明），所以换背景图只需改这一处，
             三个页面自动统一，不会出现「切到设置页背景暗一下」的老问题。
             不参与命中测试 —— 鼠标该落给上面的板面和侧栏。 -->
        <Border x:Name="WindowBackdrop" Grid.ColumnSpan="3" IsHitTestVisible="False">
            <Grid>
                <Image x:Name="BackdropImage" Stretch="UniformToFill"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
                <Border x:Name="BackdropTint">
                    <Border.Background>
                        <SolidColorBrush Color="#A61B1B1B"/>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 毛玻璃 ============
             模糊交给 DWM 亚克力（SetWindowCompositionAttribute），
             染色由 BoardSurface 的半透明底色承担，两层各司其职。
             自绘截图模糊链已退役（2026-11-17）。 -->

        <!-- ============ 左侧图标栏（Win10 结构：上=所有应用，下=文档/工具/设置/电源） ============ -->
        <Border Grid.Column="0" Background="{StaticResource RailBack}">
            <Grid>
                <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                    <!-- 三横线 = Win10 的「所有应用」：点开左栏展开成 258 宽的名单 -->
                    <Button x:Name="BtnApps" Style="{StaticResource RailButton}"
                            Content="&#xE700;" ToolTip="开始"
                            Click="BtnApps_Click"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <!-- 应用库：可搜索、可把应用拖到板上。和上面的「所有应用」是两套界面 -->
                    <Button x:Name="BtnLibrary" Style="{StaticResource RailButton}"
                            Content="&#xE8F1;" ToolTip="应用库"
                            Click="BtnLibrary_Click"/>
                    <Button x:Name="BtnPhone" Style="{StaticResource RailButton}"
                            Content="&#xE8EA;" ToolTip="移动设备" Click="BtnPhone_Click"/>
                    <Button x:Name="BtnDocuments" Style="{StaticResource RailButton}"
                            Content="&#xE8B7;" ToolTip="文档" Click="BtnDocuments_Click"/>
                    <Button x:Name="BtnTools" Style="{StaticResource RailButton}"
                            Content="&#xE712;" ToolTip="工具" Click="BtnTools_Click"/>
                    <Button x:Name="BtnAppearance" Style="{StaticResource RailButton}"
                            Content="&#xE790;" ToolTip="个性化" Click="BtnAppearance_Click"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource RailButton}"
                            Content="&#xE713;" ToolTip="Windows 设置" Click="BtnSettings_Click"/>
                    <!-- 退出磁贴板：单独一颗，摆在电源上方。电源那颗弹的是系统自己的
                         「关闭 Windows」对话框，退程序这种事不该混在里面 -->
                    <Button x:Name="BtnQuit" Style="{StaticResource RailButton}"
                            Content="&#xE711;" ToolTip="退出磁贴板" Click="BtnQuit_Click"/>
                    <Button x:Name="BtnPower" Style="{StaticResource RailButton}"
                            Content="&#xE7E8;" ToolTip="电源（系统关机菜单）" Click="BtnPower_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 磁贴区 ============ -->
        <Border x:Name="BoardSurface" Grid.Column="1" Background="Transparent"
                MouseRightButtonUp="BoardSurface_MouseRightButtonUp">
            <ScrollViewer x:Name="BoardScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Visible">
                <!-- 分组不再是 WrapPanel 顺着流，而是按自己的 (Column, Row) 落位，
                     这样才能被拖到板面任意格位。内容比视口宽时出横向位置条 -->
                <controls:GroupCanvas x:Name="GroupsHost" Margin="17,16,4,20"/>
            </ScrollViewer>
        </Border>

        <!-- 右边缘：拖动改宽度，双击铺满全屏。
             底色带 1 级 alpha 而不是纯 Transparent —— 分层窗口里 alpha=0 的像素收不到鼠标。 -->
        <Border x:Name="ResizeGrip" Grid.Column="2"
                Background="#01FFFFFF" Cursor="SizeWE"
                ToolTip="拖动改变宽度，双击铺满屏幕"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp">
            <Border x:Name="ResizeGripLine" Width="1" Background="#1FFFFFFF"
                    HorizontalAlignment="Left"/>
        </Border>

        <!-- 上边缘抓取条放在最后面（见下面 DragLayer 之前）：
             设置页、手机浮层都会盖住磁贴区，抓取条必须在它们之上才拖得动 -->

        <!-- ============ 手机连接页 ============
             和设置页一样是整页，不是浮层。内容全部来自 Phone Link 写下的
             StartMenuCompanion.json：设备名、连接状态、四个 ms-phone: 深链、最近通知，一条都不编。 -->
        <Border x:Name="PhonePage" Grid.Column="1"
                Background="Transparent"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="返回" Style="{StaticResource FlatButton}"
                        HorizontalAlignment="Left" Margin="30,20,0,0"
                        Click="PhoneBack_Click"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="30,10,30,30">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">

                        <TextBlock Text="移动设备" FontSize="24" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="这台电脑配对的手机，状态与最近通知"
                                   FontSize="12.5" Foreground="#9A9A9A" Margin="0,5,0,0"/>

                        <Border Height="1" Background="#1FFFFFFF" Margin="0,20,0,14"/>

                        <StackPanel x:Name="PhoneBody"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ 设置页 ============
             不是浮层：点侧边栏的按钮，整块磁贴区换成这一页，返回即回到板面。
             控件名沿用外观浮层那一套，滑块的事件处理不用跟着改。 -->
        <Border x:Name="SettingsPage" Grid.Column="1"
                Background="Transparent"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="返回" Style="{StaticResource FlatButton}"
                        HorizontalAlignment="Left" Margin="30,20,0,0"
                        Click="SettingsBack_Click"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="30,10,30,30">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">

                        <TextBlock Text="个性化" FontSize="24" FontWeight="SemiBold"
                                   Foreground="White"/>

                        <Border Height="1" Background="#1FFFFFFF" Margin="0,20,0,22"/>

                        <!-- ===== 背景 ===== -->
                        <TextBlock Text="背景" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#EDEDED" Margin="0,0,0,12"/>

                        <CheckBox x:Name="BackdropCheck" Content="自定义背景图片"
                                  Style="{StaticResource SettingCheck}"
                                  FontSize="12.5"
                                  ToolTip="用一张图铺满磁贴板"
                                  Checked="BackdropCheck_Changed"
                                  Unchecked="BackdropCheck_Changed"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnPickBackdrop" Content="选择图片…"
                                    Style="{StaticResource FlatButton}" Click="BtnPickBackdrop_Click"/>
                            <Button x:Name="BtnClearBackdrop" Content="清除"
                                    Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                    Click="BtnClearBackdrop_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="BackdropPathText" Text="未选择图片"
                                   FontSize="11" Foreground="#858585" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="480"
                                   HorizontalAlignment="Left"/>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="背景透明度" FontSize="12.5" Foreground="#DCDCDC"/>
                            <TextBlock x:Name="OpacityValue" Text="65%" HorizontalAlignment="Right"
                                       FontSize="12.5" Foreground="#9A9A9A"/>
                        </Grid>
                        <Slider x:Name="OpacitySlider" Minimum="15" Maximum="100" Value="65"
                                Style="{StaticResource SettingSlider}"
                                Margin="0,4,0,0" ValueChanged="OpacitySlider_ValueChanged"/>
                        <TextBlock Text="越低越透"
                                   FontSize="11" Foreground="#858585" Margin="0,4,0,0"/>

                        <CheckBox x:Name="AcrylicCheck" Content="启用毛玻璃"
                                  Style="{StaticResource SettingCheck}"
                                  FontSize="12.5" Margin="0,16,0,0"
                                  ToolTip="系统模糊；关掉是纯半透明"
                                  Checked="AcrylicCheck_Changed"
                                  Unchecked="AcrylicCheck_Changed"/>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="滚动惯性" FontSize="12.5" Foreground="#DCDCDC"/>
                            <TextBlock x:Name="InertiaValue" Text="45" HorizontalAlignment="Right"
                                       FontSize="12.5" Foreground="#9A9A9A"/>
                        </Grid>
                        <Slider x:Name="InertiaSlider" Minimum="0" Maximum="100" Value="45"
                                Style="{StaticResource SettingSlider}"
                                Margin="0,4,0,0" ValueChanged="InertiaSlider_ValueChanged"/>
                        <TextBlock Text="0 关闭，越大滑得越远"
                                   FontSize="11" Foreground="#858585" Margin="0,4,0,0"/>

                        <Border Height="1" Background="#1FFFFFFF" Margin="0,24,0,22"/>

                        <!-- ===== 尺寸 ===== -->
                        <TextBlock Text="磁贴板尺寸" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#EDEDED" Margin="0,0,0,12"/>

                        <CheckBox x:Name="FullScreenCheck" Content="铺满整个屏幕（全屏）"
                                  Style="{StaticResource SettingCheck}"
                                  FontSize="12.5" Margin="0,0,0,12"
                                  Checked="FullScreenCheck_Changed"
                                  Unchecked="FullScreenCheck_Changed"/>

                        <Grid>
                            <TextBlock Text="宽度" FontSize="12.5" Foreground="#DCDCDC"/>
                            <TextBlock x:Name="WidthValue" Text="560" HorizontalAlignment="Right"
                                       FontSize="12.5" Foreground="#9A9A9A"/>
                        </Grid>
                        <Slider x:Name="WidthSlider" Minimum="560" Maximum="3000" Value="560"
                                Style="{StaticResource SettingSlider}"
                                Margin="0,4,0,0" ValueChanged="WidthSlider_ValueChanged"/>

                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="高度" FontSize="12.5" Foreground="#DCDCDC"/>
                            <TextBlock x:Name="HeightValue" Text="900" HorizontalAlignment="Right"
                                       FontSize="12.5" Foreground="#9A9A9A"/>
                        </Grid>
                        <Slider x:Name="HeightSlider" Minimum="320" Maximum="2000" Value="900"
                                Style="{StaticResource SettingSlider}"
                                Margin="0,4,0,0" ValueChanged="HeightSlider_ValueChanged"/>

                        <CheckBox x:Name="FullWidthCheck" Content="磁贴铺满屏幕宽度"
                                  Style="{StaticResource SettingCheck}"
                                  FontSize="12.5" Margin="0,16,0,0"
                                  Checked="FullWidthCheck_Changed"
                                  Unchecked="FullWidthCheck_Changed"/>

                        <TextBlock Text="拖边缘改尺寸，双击上边缘切全屏"
                                   Foreground="#8E8E8E" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,12,0,0" LineHeight="17"/>

                        <Border Height="1" Background="#1FFFFFFF" Margin="0,24,0,22"/>

                        <!-- ===== 启动 ===== -->
                        <TextBlock Text="启动" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#EDEDED" Margin="0,0,0,12"/>

                        <CheckBox x:Name="AutostartCheck" Content="开机自动启动"
                                  Style="{StaticResource SettingCheck}"
                                  FontSize="12.5"
                                  ToolTip="登录后后台待命，按 Win 键唤出"
                                  Checked="AutostartCheck_Changed"
                                  Unchecked="AutostartCheck_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ 应用库（Win10「所有应用」的字母表） ============
             和设置页、手机页不一样，这一块不是整页：查看器和磁贴必须同时在场上，
             才可能把左边列表里的应用直接拖到右边板面当磁贴。
             所以它只是贴在磁贴区左缘的一列（336），右边那半板面照常可见、可落点。
             一开始拖，它自己先收起来，把整块板面让给落点 —— 不然目标全被它盖住。 -->
        <Border x:Name="AppsPanel" Grid.Column="1"
                HorizontalAlignment="Left" Width="336"
                Background="#FF141414"
                BorderBrush="#1CFFFFFF" BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部：搜索 + 收起。搜索沿用旧浮层那一套控件名，事件不用改 -->
                <Grid Grid.Row="0" Margin="12,12,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#262626" CornerRadius="3" Height="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center" Margin="10,0,8,0"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextMain}" CaretBrush="{StaticResource TextMain}"
                                         VerticalContentAlignment="Center" FontSize="12"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchHint" Text="搜索应用" IsHitTestVisible="False"
                                           Foreground="#707070" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="&#xE711;"
                            Style="{StaticResource RailButton}" Width="30" Height="30"
                            Margin="6,0,0,0" ToolTip="收起（Esc）"
                            Click="AppsClose_Click"/>
                </Grid>

                <!-- 列表：字母标题和应用行走同一套数据，标题就是一条不可拖的「行」。
                     这样既不用 CollectionViewSource 分组，也不会掉出虚拟化 —— 四百多个应用照样滑动顺畅。 -->
                <ListBox x:Name="AppsList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         Padding="0,0,0,14"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         PreviewMouseLeftButtonDown="AppsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="AppsList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="AppsList_PreviewMouseLeftButtonUp"
                         PreviewMouseWheel="AppsList_PreviewMouseWheel"
                         MouseRightButtonUp="AppsList_MouseRightButtonUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- 选中态不画任何东西：Win10 的所有应用列表点了就直接启动 -->
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- 字母标题：比应用名暗一档，上下留白，和 Win10 一样只靠间距分隔 -->
                                <Border x:Name="Hdr" Padding="14,10,8,4" Visibility="Collapsed">
                                    <TextBlock Text="{Binding HeaderText}" FontSize="12.5"
                                               Foreground="#A8A8A8"/>
                                </Border>

                                <Border x:Name="Row" MinHeight="32" CornerRadius="2"
                                        Margin="6,0,6,0" Padding="8,4,8,4"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{Binding Icon}" Width="20" Height="20"
                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12.5" Foreground="#EDEDED"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- 最近添加的应用：名字下面挂一行小字，Win10 同款 -->
                                            <TextBlock x:Name="RecentMark" Text="最近添加"
                                                       FontSize="10" Foreground="#8C8C8C"
                                                       Margin="0,3,0,0"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>

                                        <TextBlock x:Name="PinMark" Grid.Column="2" Text="已在板上"
                                                   FontSize="10.5" Foreground="#7A7A7A"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter TargetName="Hdr" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRecent}" Value="True">
                                    <Setter TargetName="RecentMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Row" Property="MinHeight" Value="46"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter TargetName="PinMark" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#2E2E2E"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ============ 字母索引浮层 ============
                     点应用库里的字母标题弹出来，和 Win10 一样 4 列：第一排是
                     「时钟 / & / # / A」，最后两格是 Z 和地球。没有应用的字母是灰的，
                     点它也不动 —— Win10 里那几个空组就是这副样子。
                     悬停那一格会亮出方框和四道向外伸的短线，这是索引面板的点睛处。 -->
                <Grid x:Name="LetterIndex" Grid.RowSpan="2" Visibility="Collapsed"
                      Background="#EA1E1E1E" Opacity="0"
                      MouseLeftButtonUp="LetterIndex_BackdropUp">

                    <ItemsControl x:Name="LetterIndexGrid"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="240" Margin="0,0,0,8"
                                  RenderTransformOrigin="0.5,0.5"
                                  IsHitTestVisible="True">
                        <!-- 出现时从 1.22 缩到 1：Win10 的索引面板是从略大的一版收进来的，
                             不是原地淡出来。缩放挂在网格上，压暗的底板不跟着缩。 -->
                        <ItemsControl.RenderTransform>
                            <ScaleTransform x:Name="LetterIndexScale" ScaleX="1" ScaleY="1"/>
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Cell" Height="58" Background="Transparent"
                                      MouseLeftButtonUp="LetterCell_Click">

                                    <Border x:Name="Frame" Margin="3" CornerRadius="1"
                                            BorderThickness="1" BorderBrush="Transparent"
                                            Background="Transparent"/>

                                    <TextBlock x:Name="Glyph" Text="{Binding Text}"
                                               FontSize="13.5" Foreground="#FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <!-- 悬停时从四边向外伸出的短线，Win10 索引面板的记号 -->
                                    <Rectangle x:Name="LineT" Width="1" Height="7" Fill="#3DFFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,-8,0,0" Visibility="Collapsed"
                                               IsHitTestVisible="False"/>
                                    <Rectangle x:Name="LineB" Width="1" Height="7" Fill="#3DFFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Margin="0,0,0,-8" Visibility="Collapsed"
                                               IsHitTestVisible="False"/>
                                    <Rectangle x:Name="LineL" Width="7" Height="1" Fill="#3DFFFFFF"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="-8,0,0,0" Visibility="Collapsed"
                                               IsHitTestVisible="False"/>
                                    <Rectangle x:Name="LineR" Width="7" Height="1" Fill="#3DFFFFFF"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,-8,0" Visibility="Collapsed"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <!-- 空组：字变灰，并且收不到鼠标（点了也不该有反应） -->
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="#6A6A6A"/>
                                        <Setter TargetName="Cell" Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>

                                    <!-- 时钟与地球用系统字形，字号比字母大一号才压得住 -->
                                    <DataTrigger Binding="{Binding IsIcon}" Value="True">
                                        <Setter TargetName="Glyph" Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                        <Setter TargetName="Glyph" Property="FontSize" Value="16"/>
                                    </DataTrigger>

                                    <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="#38FFFFFF"/>
                                        <Setter TargetName="Frame" Property="Background" Value="#0FFFFFFF"/>
                                        <Setter TargetName="LineT" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="LineB" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="LineL" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="LineR" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 展开后的左侧栏 ============
             Win10 里点左上角三横线，做的是「把左边那条图标栏拉开」：本来只有图标，
             拉开后每个按钮旁边露出它的名字，上面还有当前用户的名字。
             三横线自己叫「开始」，不是又一个应用库入口 —— 应用库有它自己那颗书本图标。

             按钮留在底部不挪位置：收起时它们就在那儿，展开只是同一条栏长胖了。
             要是把它们挪到顶部，看起来就成了「另开一个面板」，而不是「这条栏展开」。

             为什么用覆盖层而不是真把侧栏加宽：板面列数按宽度现算，宽一挤就得重排格位，
             主人摆好的磁贴会被搅散。它贴着左边缘长出来，看不出接缝，代价小得多。 -->
        <Border x:Name="StartPane" Grid.Column="0" Grid.ColumnSpan="2"
                HorizontalAlignment="Left" Width="258"
                Background="#FF1F1F1F"
                BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0"
                ClipToBounds="True"
                Visibility="Collapsed">
            <Grid>
                <Grid.Resources>
                    <!-- 宽版按钮：悬停给一层淡淡底色，跟系统菜单一个手感 -->
                    <Style x:Key="StartNavItem" TargetType="Border">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题行：三横线 + 开始。在这儿再点一下就收回去 -->
                <Border Grid.Row="0" Height="48" Background="#FF1F1F1F"
                        Cursor="Hand" ToolTip="收起侧边栏"
                        MouseLeftButtonUp="StartToggle_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#FFFFFF" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="开始" FontSize="13" Foreground="#FFFFFF"
                                   Margin="18,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </Border>

                <!-- 底部：当前用户 + 侧边栏那几颗按钮的宽版 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,10"/>

                    <Grid Height="44" Margin="16,0,16,4" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="30" Height="30" CornerRadius="15" Background="#3A3A3A"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#D8D8D8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="StartUser" Grid.Column="1" Text=""
                                   FontSize="12.5" Foreground="#EDEDED"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Border Style="{StaticResource StartNavItem}" Tag="library"
                            MouseLeftButtonUp="StartNav_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#EDEDED" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="应用库" FontSize="12.5" Foreground="#EDEDED"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StartNavItem}" Tag="phone"
                            MouseLeftButtonUp="StartNav_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#EDEDED" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="移动设备" FontSize="12.5" Foreground="#EDEDED"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StartNavItem}" Tag="docs"
                            MouseLeftButtonUp="StartNav_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#EDEDED" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="文档" FontSize="12.5" Foreground="#EDEDED"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StartNavItem}" Tag="tools"
                            MouseLeftButtonUp="StartNav_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#EDEDED" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="工具" FontSize="12.5" Foreground="#EDEDED"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StartNavItem}" Tag="appearance"
                            MouseLeftButtonUp="StartNav_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#EDEDED" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="个性化" FontSize="12.5" Foreground="#EDEDED"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StartNavItem}" Tag="settings"
                            MouseLeftButtonUp="StartNav_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#EDEDED" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="Windows 设置" FontSize="12.5" Foreground="#EDEDED"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StartNavItem}" Tag="quit"
                            MouseLeftButtonUp="StartNav_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#EDEDED" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="退出磁贴板" FontSize="12.5" Foreground="#EDEDED"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StartNavItem}" Tag="power"
                            MouseLeftButtonUp="StartNav_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="#EDEDED" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="电源" FontSize="12.5" Foreground="#EDEDED"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 临时提示 ============ -->
        <Border x:Name="Toast" Grid.ColumnSpan="3"
                Background="#E62C2C2C" CornerRadius="4" Padding="14,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,26" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="#EAEAEA" FontSize="12"/>
        </Border>

        <!-- 拖动时跟随鼠标的那块磁贴就放在这层，不参与命中测试 -->
        <!-- 上边缘：拖动改高度（底边贴住工作区底部，往上长），双击切全屏。
             放在所有页面之后＝最上层，否则设置页、手机页会把这 6px 盖住，拖不动。
             照样要点 1 级 alpha，分层窗口里 alpha=0 收不到鼠标。 -->
        <Border x:Name="ResizeGripTop" Grid.Column="1"
                Height="6" VerticalAlignment="Top"
                Background="#01FFFFFF" Cursor="SizeNS"
                ToolTip="拖动改变高度，双击切换全屏"
                MouseLeftButtonDown="ResizeTop_MouseLeftButtonDown"
                MouseMove="ResizeTop_MouseMove"
                MouseLeftButtonUp="ResizeTop_MouseLeftButtonUp"/>

        <Canvas x:Name="DragLayer" Grid.ColumnSpan="3" IsHitTestVisible="False"/>

    </Grid>
</Window>
